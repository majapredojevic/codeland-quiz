APP_NAME=CodeLand Quiz
APP_ENV=development
APP_URL=https://localhost

DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

ACCESS_TOKEN_COOKIE_NAME=codeland_access
REFRESH_TOKEN_COOKIE_NAME=codeland_refresh
COOKIE_PATH=/
CSRF_TOKEN_COOKIE_NAME=codeland_csrf
REFRESH_TOKEN_HASH_KEY=

PARTICIPANT_TOKEN_SECRET=replace-with-at-least-32-random-characters
PARTICIPANT_TOKEN_TTL_SECONDS=86400

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=7
CSRF_TOKEN_EXPIRATION_MINUTES=120

LOGIN_ATTEMPT_LIMIT=5
LOGIN_LOCK_DURATION_MINUTES=15
# Broader shared-network ceiling; successful logins do not consume it.
LOGIN_IP_ATTEMPT_LIMIT=100

# Empty in direct local development. Production must trust only its controlled
# reverse-proxy peer/network before X-Real-IP is accepted.
TRUSTED_PROXY_CIDRS=

# Exact browser origins only. Production should list its trusted HTTPS origin(s).
WS_ALLOWED_ORIGINS=http://localhost:4200
# Auth and answer frames are small; 16 KiB leaves ample JWT/JSON headroom.
WS_GAMEPLAY_MAX_FRAME_BYTES=16384
WS_AUTH_ATTEMPT_LIMIT=3
# Allows 500 students plus reconnect headroom behind a school NAT each minute.
WS_AUTH_IP_ATTEMPT_LIMIT=1000
WS_AUTH_IP_WINDOW_SECONDS=60
WS_ANSWER_ATTEMPT_LIMIT=8
WS_ANSWER_ATTEMPT_WINDOW_SECONDS=10
# Broad ceilings support 500 students and multiple classrooms in one worker.
WS_CONNECTION_LIMIT=2000
WS_PENDING_CONNECTION_LIMIT=750
WS_CONNECTION_PER_IP_LIMIT=750
# One shared server sweep sends a tiny application heartbeat every 25 seconds.
WS_HEARTBEAT_INTERVAL_SECONDS=25
WS_STALE_TIMEOUT_SECONDS=75

# Runtime ceilings remain above the 2000-socket application budget.
OPENSWOOLE_MAX_CONNECTIONS=4096
OPENSWOOLE_MAX_COROUTINES=4096
PERFORMANCE_PROFILING_ENABLED=false
# Transport cleanup is a later safety net behind the application presence timeout.
OPENSWOOLE_TRANSPORT_HEARTBEAT_CHECK_INTERVAL_SECONDS=30
OPENSWOOLE_TRANSPORT_HEARTBEAT_IDLE_SECONDS=120

COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=Strict

MAX_UPLOAD_SIZE_MB=5
QUESTION_IMAGE_STORAGE_PATH=storage/question-images
DEFAULT_QUIZ_QUESTION_TIME_LIMIT_SECONDS=30
MAXIMUM_NICKNAME_LENGTH=100
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=20
