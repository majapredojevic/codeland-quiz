{
    "name": "maja/codeland-quiz-backend",
    "description": "Real-time quiz platform backend built with PHP and OpenSwoole.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "CodeLandQuiz\\": "src/"
        }
    },
    "require-dev": {
        "openswoole/ide-helper": "^26.2"
    },
    "scripts": {
        "verify-security": "@php scripts/verify-security-hardening.php",
        "verify-production": "@php scripts/verify-production-hardening.php",
        "verify-images": "@php scripts/verify-question-image-storage.php",
        "verify-runtime": "@php scripts/verify-runtime-hardening.php",
        "verify-profiling": "@php scripts/verify-performance-profiling.php",
        "verify-bootstrap": "@php scripts/verify-initial-admin-bootstrap.php"
    }
}
