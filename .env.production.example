# Copy this file to .env.production, replace every marked value, and protect it
# with owner-only filesystem permissions. Never commit the resulting file.

SERVER_NAME=quiz.example.com
CODELAND_IMAGE_TAG=2026.08.18-phase2
TLS_CERTIFICATE_PATH=/absolute/protected/path/fullchain.pem
TLS_PRIVATE_KEY_PATH=/absolute/protected/path/privkey.pem

APP_NAME=CodeLand Quiz
APP_ENV=production
APP_URL=https://quiz.example.com

DB_DATABASE=codeland_quiz
DB_USERNAME=replace-with-production-database-user
DB_PASSWORD=replace-with-at-least-16-random-characters
MYSQL_ROOT_PASSWORD=replace-with-a-distinct-random-root-password

ACCESS_TOKEN_COOKIE_NAME=codeland_access
REFRESH_TOKEN_COOKIE_NAME=codeland_refresh
COOKIE_PATH=/
CSRF_TOKEN_COOKIE_NAME=codeland_csrf
REFRESH_TOKEN_HASH_KEY=replace-with-at-least-32-random-characters

PARTICIPANT_TOKEN_SECRET=replace-with-a-distinct-32-character-random-secret
PARTICIPANT_TOKEN_TTL_SECONDS=86400

JWT_SECRET=replace-with-a-distinct-32-character-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=7
CSRF_TOKEN_EXPIRATION_MINUTES=120

LOGIN_ATTEMPT_LIMIT=5
LOGIN_LOCK_DURATION_MINUTES=15
LOGIN_IP_ATTEMPT_LIMIT=100

# This exact /32 is assigned to Nginx by compose.production.yaml.
TRUSTED_PROXY_CIDRS=172.30.0.10/32
WS_ALLOWED_ORIGINS=https://quiz.example.com
WS_GAMEPLAY_MAX_FRAME_BYTES=16384
WS_AUTH_ATTEMPT_LIMIT=3
WS_AUTH_IP_ATTEMPT_LIMIT=1000
WS_AUTH_IP_WINDOW_SECONDS=60
WS_ANSWER_ATTEMPT_LIMIT=8
WS_ANSWER_ATTEMPT_WINDOW_SECONDS=10
WS_CONNECTION_LIMIT=2000
WS_PENDING_CONNECTION_LIMIT=750
WS_CONNECTION_PER_IP_LIMIT=750

COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=Strict

MAX_UPLOAD_SIZE_MB=5
QUESTION_IMAGE_STORAGE_PATH=/var/www/backend/storage/question-images
DEFAULT_QUIZ_QUESTION_TIME_LIMIT_SECONDS=30
MAXIMUM_NICKNAME_LENGTH=100
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=20
